# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8080

# Origin of the frontend, used for CORS (must be exact to allow cookies)
CLIENT_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=expense_tracker
# Set to true for managed databases that require TLS (e.g. RDS, Neon, Supabase)
DB_SSL=false
# Log SQL queries (useful while developing)
DB_LOGGING=false

# JWT signing secret: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# How long a login lasts (token and cookie lifetime)
JWT_EXPIRES_IN_DAYS=7

# Serve Swagger UI at /api-docs (defaults to true, or false when NODE_ENV=production)
# API_DOCS_ENABLED=true
